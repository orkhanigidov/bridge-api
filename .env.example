# Master Admin Key: Used to generate new API secrets. 
# Recommended length: 64 characters for high security.
MASTER_ADMIN_KEY=your_64_char_random_string_here

# API Secret: Used by the frontend to authenticate requests.
# Recommended length: 32 characters.
API_SECRET=your_32_char_random_string_here

GHCR_IMAGE=ghcr.io/orkhanigidov/bridge-api:latest
ENGINE_PORT=8000
GATEWAY_PORT=8080
